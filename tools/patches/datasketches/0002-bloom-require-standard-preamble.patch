Require the standard preamble for a non-empty Bloom filter.

A header with the 3-long empty preamble but the empty flag clear passes the
minimum-size check for 24 bytes, then reads num_bits_set at offset 24: a
heap over-read found by data.sketches tools/fuzz under ASan.

--- a/filters/include/bloom_filter_impl.hpp	2026-11-16 18:31:08
+++ b/filters/include/bloom_filter_impl.hpp	2026-11-16 18:31:08
@@ -390,6 +390,12 @@
     throw std::invalid_argument("Cannot wrap an empty filter for writing");
   } else if (is_empty) {
     return bloom_filter_alloc<A>(num_longs << 6, num_hashes, seed, allocator);
+  }
+
+  // A non-empty filter carries the standard preamble; with the empty one the
+  // bit count below would be read past the bytes checked above.
+  if (prelongs != PREAMBLE_LONGS_STANDARD) {
+    throw std::invalid_argument("Possible corruption: non-empty filter with an empty-filter preamble");
   }
 
   uint64_t raw_num_bits_set;
