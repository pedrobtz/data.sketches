+// As for compact Theta sketches: an empty sketch holds no entries, theta does
+// not exceed MAX_THETA, and the keys lie in (0, theta), strictly increasing
+// when ordered and never repeated. An empty image with an entry re-serialized
+// with a zero seed hash that was then refused (found by data.sketches
+// tools/fuzz).
+template<typename Entries, typename Allocator>
+static void check_entries(bool is_empty, bool is_ordered, uint64_t theta, const Entries& entries, const Allocator& allocator) {
+  if (is_empty && !entries.empty()) {
+    throw std::invalid_argument("Possible corruption: empty sketch with entries");
+  }
+  if (theta > theta_constants::MAX_THETA) {
+    throw std::invalid_argument("Possible corruption: theta exceeds its maximum");
+  }
+  using AllocU64 = typename std::allocator_traits<Allocator>::template rebind_alloc<uint64_t>;
+  std::vector<uint64_t, AllocU64> keys(allocator);
+  keys.reserve(entries.size());
+  uint64_t previous = 0;
+  for (const auto& entry: entries) {
+    const uint64_t key = entry.first;
+    if (key == 0 || key >= theta || (is_ordered && key <= previous)) {
+      throw std::invalid_argument("Possible corruption: compact sketch entry out of range or out of order");
+    }
+    previous = key;
+    keys.push_back(key);
+  }
+  if (!is_ordered && keys.size() > 1) {
+    std::sort(keys.begin(), keys.end());
+    if (std::adjacent_find(keys.begin(), keys.end()) != keys.end()) {
+      throw std::invalid_argument("Possible corruption: duplicate entry in compact sketch");
+    }
+  }
+}
